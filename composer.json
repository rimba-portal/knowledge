{
    "name": "rimba/knowledge",
    "description": "Controlled documents, learning and qualification for the Rimba application.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["rimba", "filament", "dms", "lms", "qualification", "iec-62264"],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "filament/filament": "^5.0",
        "rimba/asas": "*",
        "rimba/boleh": "*",
        "rimba/pihak": "*",
        "rimba/pinta": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rimba\\Knowledge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rimba\\Knowledge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rimba\\Knowledge\\KnowledgeServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --test",
        "test": "phpunit",
        "analyse-package": "php tools/validate-package.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
